  "dependencies": {
    "hands-on-client": "git+ssh://git@github.com:asteriscoeducacao/hands-on-client.git",
    "hands-on-common": "git+ssh://git@github.com:asteriscoeducacao/hands-on-common.git",
    "hands-on-course": "git+ssh://git@github.com:asteriscoeducacao/hands-on-course.git",
    "hands-on-server": "git+ssh://git@github.com:asteriscoeducacao/hands-on-server.git"
  },
  "scripts": {
    "clear-cache": "yarn cache clean --all",
    "dev": "yarn install && yarn as-upgrade && hands-on-server",
